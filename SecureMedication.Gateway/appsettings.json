{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  //Section pointed in the Dependency Injection where the Routes will be defined for the Routing
  "ReverseProxy": {
    //Section where the Routed routes are declared
    "Routes": {
      //Defining the correspondential route for the User application
      "UsersRouteEndpoint": {
        //Correspondential cluster of the user application address
        "ClusterId": "usersCluster",
        //Defining the path to get to the methods
        "Match": {
          /*Defines the path to communicate with the Users management application.
            This defines that to communicate with the Users.Api need to add usersMRS which becomes 
            the door to access Users.Api controllers. To access the controllers it's defined in curly 
            brackets a general space where the user can enter all the endpoints stablished in controller.*/

          //Example: usersMRS/users/home
          "Path": "usersMRS/{**catch-all}"
        },
        //Defining the general space to add any endpoint that belongs to the Users.Api controller
        "Transforms": [ { "PathPattern": "{**catch-all}" } ]
      }
    }
  },
  //Second section where the microservices address configuration is made
  "Clusters": {
    //Defining the cluster focused int the application Users.Api
    //Clusters Id
    "usersCluster": {
      //Section where the addresses are stored
      "Destinations": {
        //Address where the outside applications can reach the application Users.Api. 
        /*It uses the name of the User.Api in the "service:" section. 
        Then it uses the port where the computer listens, to pass it though the Docker file to the port
        where the application listens, which is 8084 (defined in the Docker Composed"5100:8084")*/
        "usersAddress": "http://securemedication.users.api:5100"
      },
      //Implementing load balancing by having more than one port to access the application
      "destination2": {
        "usersAddress": "http://securemedication.users.api:5200"
      }
    }
  }
}
